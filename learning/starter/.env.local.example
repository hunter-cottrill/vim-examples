# OAuth credentials from the Vim developer portal — https://developer-docs.getvim.ai
# Copy to .env.local (gitignored) and fill in. Never commit .env.local.
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
APP_ENV=staging   # local | staging | production

# Dev-only simulator (see README). Never set true in staging/production.
NEXT_PUBLIC_SIM_MODE=false
