{
  "name": "vim-transition-of-care-app",
  "version": "0.1.0",
  "description": "Transition-of-care app on the Vim Connect SDK — on chart open, shows whether a patient was recently hospitalized and which discharge diagnoses/medications aren't yet reflected on the chart",
  "license": "MIT",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "start": "next start -p 8080",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vimconnect/app-sdk": "0.4.56",
    "next": "^16.2.12",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.5.3",
    "vitest": "^4.1.1"
  }
}
