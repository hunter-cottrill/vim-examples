# OAuth credentials from the Vim developer portal — https://developer-docs.getvim.ai
# Copy to .env.local (gitignored) and fill in. Never commit .env.local.
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
APP_ENV=staging   # local | staging | production

# Server-only — used by /api/referral/explain to rank/explain among the
# deterministic network-match shortlist with Claude. Optional: if unset, that
# route falls back to the plain rule-based rationale. Never prefix NEXT_PUBLIC_.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
