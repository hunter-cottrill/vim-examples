# OAuth credentials from the Vim developer portal
# See: https://developer-docs.stage.getvim.ai
# Copy to .env.local (gitignored) and fill in. Never commit .env.local.
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
APP_ENV=staging   # local | staging | production

# Dev-only simulator (see README "Run without an EHR"). When true, enables
# /dev/harness and the in-app simulator controls; the real SDK path is
# untouched when unset. Default false.
NEXT_PUBLIC_SIM_MODE=false
